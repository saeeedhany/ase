# Build output
build/
build-*/
out/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Qt
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
.qmake.stash
*.pro.user
*.pro.user.*

# Object/binary artifacts
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Sanitizer/fuzz output
*.log
crash-*
*.profraw

# Packaging outputs — packaging/README.md documents how to (re)build
# each of these; none of the generated artifacts belong in git.
packaging/appimage/.tools/
packaging/appimage/AppDir/
packaging/appimage/*.AppImage
packaging/debian/pkgroot/
packaging/debian/*.deb
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/*.pkg.tar.zst
packaging/arch/*.tar.gz

# Docs site (see docs/requirements.txt + mkdocs.yml) — built/served
# locally, deployed via `mkdocs gh-deploy` (pushes to the gh-pages
# branch directly, nothing to commit here on main).
.venv-docs/
site/

# Scratch files the tests write into whatever the working directory
# happens to be. test_config.c removes its own on the way out, but not
# when a CHECK fails partway through, and one has been committed by
# accident already.
*.tmp

# Screenshots taken while verifying the GUI on a real display. They are
# written next to whatever the working directory happened to be, and a
# batch of them has been committed by accident once already — capture
# them somewhere outside the repo, and if one does land here, git will
# not pick it up.
/*.png
